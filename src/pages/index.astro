---
import EditorialSection from '../components/layout/EditorialSection.astro';
import ProjectIndex from '../components/projects/ProjectIndex.astro';
import { disciplines, profile } from '../content/profile';
import { projects } from '../content/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={profile.name + ' — Portfolio'}
  description="Caleb Lopes’s personal portfolio, focused on artificial intelligence, development, and business growth."
>
  <section class="hero page-shell" aria-labelledby="hero-title">
    <h1 class="hero-title" id="hero-title">
      <span>{profile.displayName[0]}</span>{' '}
      <span>{profile.displayName[1]}</span>
    </h1>
    <div class="hero-details editorial-grid">
      <p class="hero-tagline">{profile.tagline}</p>
      <a class="hero-link text-link" href="#work">
        Explore <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <EditorialSection title="Selected Work" id="work">
    <ProjectIndex entries={projects} />
  </EditorialSection>

  <EditorialSection title="Areas of Focus" id="focus">
    <ul class="disciplines" role="list">
      {disciplines.map(({ id, title, description }) => (
        <li>
          <h3>
            <a class="discipline-link text-link" href={'/' + id + '/'}>
              {title} <span aria-hidden="true">→</span>
            </a>
          </h3>
          <p class="secondary-text">{description}</p>
        </li>
      ))}
    </ul>
  </EditorialSection>

  <EditorialSection title="About" id="about">
    <p class="introduction">{profile.introduction}</p>
    <a class="text-link" href="/about/">More about Caleb <span aria-hidden="true">→</span></a>
  </EditorialSection>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-2xl);
    min-block-size: calc(var(--hero-height) - var(--header-height));
    padding-block: var(--space-3xl) var(--space-lg);
    container-type: inline-size;
  }

  .hero-title {
    display: grid;
    align-self: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-size: clamp(var(--display-min), 23cqi, var(--display-max));
    font-weight: 800;
    line-height: var(--display-leading);
    letter-spacing: var(--display-tracking);
    text-transform: uppercase;
  }

  .hero-title span:last-child {
    justify-self: end;
  }

  .hero-details {
    row-gap: var(--space-lg);
    align-items: end;
  }

  .hero-tagline {
    grid-column: 1 / -1;
    max-width: 26ch;
    font-size: clamp(1.25rem, 2.25vw, 2rem);
    line-height: 1.2;
    letter-spacing: var(--subheading-tracking);
    text-wrap: balance;
  }

  .hero-link {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .discipline-link {
    font: inherit;
    letter-spacing: inherit;
  }

  .disciplines {
    border-block-end: var(--divider);
  }

  .disciplines li {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-lg);
    border-block-start: var(--divider);
  }

  .disciplines p,
  .introduction {
    max-inline-size: 48ch;
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-3xl) var(--space-xl);
    }

    .hero-title {
      font-size: clamp(var(--display-min), 17cqi, var(--display-max));
    }

    .hero-title span:last-child {
      margin-inline-end: 8%;
    }

    .hero-tagline {
      grid-row: 1;
      grid-column: 5 / -1;
    }

    .hero-link {
      grid-row: 1;
      grid-column: 1 / 5;
    }

    .disciplines li {
      padding-block: var(--space-xl);
    }
  }

  @media (min-width: 1024px) {
    .hero-title span:last-child {
      margin-inline-end: 12%;
    }

    .hero-tagline {
      grid-column: 10 / -1;
    }
  }

  @media (max-height: 500px) {
    .hero {
      gap: var(--space-xl);
      padding-block: var(--space-xl) var(--space-lg);
    }
  }

  @media (min-width: 768px) and (max-height: 500px) {
    .hero-title {
      font-size: clamp(var(--display-min), 20svh, var(--display-max));
    }
  }
</style>
