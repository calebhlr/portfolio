---
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { profile } from '../content/profile';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const shareImage = canonical && new URL('/og/portfolio.png', canonical);
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060606" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {canonical && <meta property="og:url" content={canonical.href} />}
    {shareImage && (
      <>
        <meta property="og:image" content={shareImage.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Caleb Lopes — Artificial Intelligence, Development, Business & Growth" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
  </head>
  <body>
    <a class="skip-link text-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    inset-block-start: var(--space-xs);
    inset-inline-start: var(--gutter);
    z-index: 1;
    padding-inline: var(--space-sm);
    background: var(--color-background);
  }

  .skip-link:not(:focus) {
    clip-path: inset(50%);
  }
</style>
